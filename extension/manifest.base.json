{
  "manifest_version": 3,
  "name": "Cliparr for Jellyfin",
  "description": "Bookmark the moment you are watching in Jellyfin and save it to your Cliparr server.",
  "version": "0.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cliparr settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
